# ============================================================
#  Auth service
# ============================================================

# ---------- Server ----------
AUTH_SERVER_PORT=8080

# ---------- Handler ----------
AUTH_TIME_CONTEXT_IN_SECOND=15
AUTH_JWT_REFRESH_TTL_DAYS=30

# ---------- Repos (in-memory + JSON persistence) ----------
AUTH_USER_REPO_PATH=./data/users.json
AUTH_REFRESH_TOKEN_REPO_PATH=./data/refresh_tokens.json
AUTH_MAX_USERS=10

# ---------- JWT (RS256) ----------
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
AUTH_JWT_ACCESS_TTL_MINUTE=15
AUTH_JWT_REFRESH_TTL_DAYS=30
AUTH_JWT_ISSUER=loregraph-auth-service
# Maximum live refresh tokens per user. Old ones are evicted as new logins
# arrive, so a client that never logs out does not grow the file forever.
AUTH_MAX_REFRESH_TOKENS_PER_USER=10

# ---------- Argon2id ----------
AUTH_ARGON2_TIME=1
AUTH_ARGON2_MEMORY=65536
AUTH_ARGON2_THREADS=4
AUTH_ARGON2_SALT_LEN=32
AUTH_ARGON2_KEY_LEN=32
AUTH_ARGON2_PEPPER=

# ---------- SHA256 ----------
AUTH_SHA256_SALT=

# ---------- Logger ----------
LOG_LEVEL=info
LOG_FORMAT=text