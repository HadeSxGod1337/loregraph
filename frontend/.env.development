# Dev only (`npm run dev`): Vite serves the page on 5173 while the backend runs
# separately on 8000, so the API is NOT same-origin and has to be named.
# The packaged setup needs none of this — there the backend serves this bundle
# itself and the API is simply wherever the page came from (see api/client.ts).
VITE_API_URL=http://localhost:8000
